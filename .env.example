# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VL_MODEL=qwen2.5vl:7b

# Pipeline paths (relative to project root)
INPUT_DIR=data/input
OUTPUT_DIR=data/output

# Rendering quality
RENDER_DPI_SCANNED=300
RENDER_DPI_DIGITAL=216

# Crop settings
CROP_PADDING_PX=8

# Recognition thresholds
RECOGNITION_MIN_CONFIDENCE=0.65
RECOGNITION_RETRY_THRESHOLD=0.60

# LLM judge (set to false to skip for speed)
JUDGE_ENABLED=true

# Ollama timeout in seconds
OLLAMA_TIMEOUT=120
